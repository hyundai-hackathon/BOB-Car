<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos read permissions (Vehicle Service protectionLevel="normal", no runtime request) -->
    <!-- Odometer distance, brake pedal -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- EV battery state of charge, fuel percent (real ICE car) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Driver seat occupancy -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Driver door position -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- VIN -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- Android car properties (normal) -->
    <!-- GEAR_SELECTION -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- INFO_EV_BATTERY_CAPACITY, INFO_FUEL_CAPACITY -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />

    <!-- NaviHelper: getDestinationInfo, getBookmarkInfo, getCurrentLocationInfo (@RequiresPermission), onRouteStarted -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BOBCar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BOBCar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
