<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos read permissions (Vehicle Service protectionLevel="normal", no runtime request) -->
    <!-- Odometer distance, brake pedal -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- EV battery state of charge, fuel percent (real ICE car) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Driver seat occupancy -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Driver door position -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- VIN -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- Android car properties (normal) -->
    <!-- GEAR_SELECTION -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- INFO_EV_BATTERY_CAPACITY, INFO_FUEL_CAPACITY -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />

    <!-- NaviHelper: getDestinationInfo, getBookmarkInfo, getCurrentLocationInfo (@RequiresPermission), onRouteStarted -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- TextToSpeech SDK (voice guidance, ON_DEVICE). Defined by ai.pleos.playground.caas, protectionLevel="normal" -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Foreground collection service (keeps the app from being frozen in the background, troubleshooting B11) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Upload queue (sends stored records to the server once SERVER_URL is set) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Shows the "collecting" notification on API 33+ (runtime permission; the service runs without it) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BOBCar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BOBCar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CollectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous collection of vehicle signals (gear, seat, odometer, battery, navigation) for the corporate vehicle logbook" />
        </service>
    </application>

</manifest>
