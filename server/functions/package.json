{
  "name": "bobcar-server",
  "private": true,
  "description": "BOB-Car server: upload, lookup and auto-close API on Firebase Functions + Firestore",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "emulators": "node scripts/emulators.js",
    "emulators:fresh": "firebase emulators:start --project demo-bobcar",
    "test": "vitest run",
    "test:emulators": "firebase emulators:exec --project demo-bobcar --only auth,firestore \"npm test\"",
    "seed": "node lib/scripts/seed.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
